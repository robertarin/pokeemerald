mapscripts Route201_MapScripts {
	MAP_SCRIPT_ON_TRANSITION : Route201_OnTransition
}

script Route201_OnTransition {
	goto_if_unset(FLAG_TRAINERS_DEFEATED_ROUTE_201, Route201_EventScript_ResetAllTrainers)
	end
}

script Route201_EventScript_Sean {
	trainerbattle_single(TRAINER_SEAN, Route201_Text_SeanIntro, Route201_Text_SeanDefeated, Route201_Event_Script_CheckTrainersCompletion)
	msgbox(Route201_Text_SeanPostBattle, MSGBOX_AUTOCLOSE)
	end
}

script Route201_EventScript_Jon {
	trainerbattle_single(TRAINER_JON, Route201_Text_JonIntro, Route201_Text_JonDefeated, Route201_Event_Script_CheckTrainersCompletion)
	msgbox(Route201_Text_JonPostBattle, MSGBOX_AUTOCLOSE)
	end
}

script Route201_Event_Script_CheckTrainersCompletion {
	goto_if_not_defeated(TRAINER_SEAN, Route201_EventScript_TrainersNotCompleted)
	goto_if_not_defeated(TRAINER_JON, Route201_EventScript_TrainersNotCompleted)
	goto_if_not_defeated(TRAINER_CAMPER_JIM, Route201_EventScript_TrainersNotCompleted)
	setflag(FLAG_TRAINERS_DEFEATED_ROUTE_201)
	release
	end
}

script Route201_EventScript_TrainersNotCompleted {
	release
	end
}

script Route201_EventScript_ResetAllTrainers {
	cleartrainerflag(TRAINER_JON)
	cleartrainerflag(TRAINER_SEAN)
	cleartrainerflag(TRAINER_CAMPER_JIM)
}

text Route201_Text_InfoSign {
	format("GAUNTLETS\p"
	"Routes in this game are known as GAUNTLETS.\p"
	"That means when you leave to heal, your opponents will heal their POKéMON as well.\p"
	"Defeat every opponent on this route without leaving to fully clear it!")
}

script Route201_EventScript_InfoSign {
	msgbox(Route201_Text_InfoSign, MSGBOX_SIGN)
}

text Route201_Text_DirectionSignNorth {
	format("Suncloak Town {UP_ARROW}\nCave {DOWN_ARROW}")
}

script Route201_EventScript_DirectionSignNorth {
	msgbox(Route201_Text_DirectionSignNorth, MSGBOX_SIGN)
}

text Route201_Text_HouseSign {
	format("Out for an errand. Be back soon!")
}

script Route201_EventScript_HouseSign {
	msgbox(Route201_Text_InfoSign, MSGBOX_SIGN)
}

text Route201_Text_SeanIntro {
	format("I don't even know what type each POKéMON is!")
}

text Route201_Text_SeanDefeated {
	format("Since when did they show POKéMON types next to their health?.")
}

text Route201_Text_SeanPostBattle {
	format("Go away.")
}

text Route201_Text_JonIntro {
	format("My POKéMON are fully healed! I'm glad I bought these potions.")
}

text Route201_Text_JonPostBattle {
	format("I didn't even agree to be here!")
}

text Route201_Text_JonDefeated {
	format("That was a tough fight!\lYou should probably go heal your POKéMON before moving on.")
}

text Route201_Text_CamperIntro {
	format("Battling outside is thrilling!")
}

text Route201_Text_CamperDefeated {
	format("I guess I'm a better camper than battler...")
}

text Route201_Text_CamperPostBattle {
	format("Hopefully I at least made you use a Pokestus charge!")
}

script Route201_EventScript_Camper {
	trainerbattle_single(TRAINER_CAMPER_JIM, Route201_Text_CamperIntro, Route201_Text_CamperDefeated, Route201_Event_Script_CheckTrainersCompletion)
	msgbox(Route201_Text_CamperPostBattle, MSGBOX_AUTOCLOSE)
}

text Route201_Text_LassIntro {
	format("I made it through the cave but I'm completely out of healing items!\pI'm not sure I'll make it to Suncloak Town...\pUnless...")
}

text Route201_Text_LassDefeated {
	format("I'm sorry! I was just afraid!")
}

text Route201_Text_LassPostBattle {
	format("I can't even heal my pokemon when you leave...")
}

script Route201_EventScript_Lass {
	lock
	faceplayer
	trainerbattle_single(TRAINER_SAD_LASS, Route201_Text_LassIntro, Route201_Text_LassDefeated)
	msgbox(Route201_Text_LassPostBattle, MSGBOX_AUTOCLOSE)
	release
}

script Route201_EventScript_Boy_1 {
	lock 
	faceplayer
	msgbox(format("Hey! Do you know how to cross these? I havn't been able to figure it out."))
	release
}